{
  "name": "Notificación por triaje crítico/alto",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "triaje-creado",
        "responseMode": "responseNode"
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.nombre_completo, t.nivel_urgencia, t.conducta_sugerida FROM triajes t JOIN pacientes p ON t.id_paciente = p.id_paciente WHERE t.id_triaje = {{$json.body.id_triaje}}"
      },
      "name": "PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.nivel_urgencia}}",
              "operation": "in",
              "value2": "alto,crítico"
            }
          ]
        }
      },
      "name": "IF Nivel Alto/Crítico",
      "type": "n8n-nodes-base.if",
      "position": [650, 300]
    },
    {
      "parameters": {
        "fromEmail": "triage@hospital.com",
        "toEmail": "equipo_medico@hospital.com",
        "subject": "ALERTA: Triaje crítico",
        "text": "Paciente: {{$json.nombre_completo}}\nNivel: {{$json.nivel_urgencia}}\nConducta sugerida: {{$json.conducta_sugerida}}"
      },
      "name": "Enviar Email",
      "type": "n8n-nodes-base.emailSend",
      "position": [850, 300]
    }
  ]
}
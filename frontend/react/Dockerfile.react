FROM node:18-alpine as build
WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .
# Si no hay index.html, crea uno básico
RUN if [ ! -f public/index.html ]; then \
      mkdir -p public && \
      echo '<!DOCTYPE html><html><head><title>Triaje IA</title></head><body><div id="root"></div></body></html>' > public/index.html; \
    fi
RUN npm run build || echo "Build falló, pero continuamos"

FROM nginx:alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]